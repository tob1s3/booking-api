# Скопируйте в .env и поменяйте секреты: cp .env.example .env
POSTGRES_PASSWORD=change-me
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Для запуска без Docker (локальный PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://booking:change-me@localhost:5432/booking

# Расписание заведения
TIMEZONE=Europe/Moscow
WORK_START=10:00
WORK_END=20:00
BREAK_START=14:00
BREAK_END=15:00
WORK_DAYS=0,1,2,3,4,5
SLOT_STEP_MINUTES=30
MIN_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=30
CANCEL_DEADLINE_HOURS=3
